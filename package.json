{
  "name": "medaccess-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MedAccess AI — AI Doctor Copilot for rural and underserved areas",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @medaccess/api run dev",
    "dev:clinic": "pnpm --filter @medaccess/clinic run dev",
    "dev:patient": "pnpm --filter @medaccess/patient run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @medaccess/api run build",
    "build:clinic": "pnpm --filter @medaccess/clinic run build",
    "build:patient": "pnpm --filter @medaccess/patient run build",
    "start": "pnpm --filter @medaccess/api run start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
