{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@medaccess/api", "run", "dev"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "clinic-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@medaccess/clinic", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "patient-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@medaccess/patient", "run", "dev"],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "image-ml",
      "runtimeExecutable": "services/image-ml/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "5001", "--app-dir", "services/image-ml"],
      "port": 5001,
      "autoPort": false
    }
  ]
}
