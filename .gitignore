node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/
.turbo/
.next/
out/
*.tsbuildinfo

# Environment / secrets (root + nested, just in case)
.env
.env.local
.env.*.local
**/.env
**/.env.local
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor / OS
.vscode/*
!.vscode/settings.json.example
.idea/
.DS_Store
Thumbs.db
*.swp

# Claude Code — per-machine permission grants (machine-specific absolute paths)
.claude/settings.local.json

# Uploads / runtime
apps/api/uploads/
apps/api/tmp/

# Test coverage
coverage/
.nyc_output/

# PWA build artifacts
apps/web/dev-dist/

# ML model weights (large binary files — never commit)
*.pt
*.onnx
*.pb
*.h5
*.keras
services/image-ml/models/
!services/image-ml/models/.gitkeep

# Screenshots (taken separately, not tracked in code commits)
docs/screenshots/

# QR tunnel runtime URLs (ephemeral)
scripts/.tunnels.json
