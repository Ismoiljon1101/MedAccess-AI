# =====================================================================
# MedAccess AI — environment variables
# Copy this file to `.env` (same directory) and fill in your keys.
# NEVER commit a real `.env` file. The .gitignore already excludes it.
# =====================================================================

# --- API server -------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173   # clinic portal (patient portal is 5174, auto-allowed)

# --- Database (OPTIONAL) -----------------------------------------------
# MongoDB Atlas free tier URI — hand via Signal / 1Password, never email.
# If unset, the API runs with in-memory arrays (data resets on restart).
MONGODB_URI=

# --- LLM provider (REQUIRED): OpenRouter ------------------------------
# Get a key at https://openrouter.ai — one key gives access to dozens of
# models (Anthropic, OpenAI, Google, DeepSeek, Meta, etc.) at competitive
# prices through an OpenAI-compatible API.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model IDs (overridable per-request from the frontend).
# Browse all available models at https://openrouter.ai/models
#
# Strategy (cost-optimised for demo):
#   Chat/diagnosis  → qwen3.5-plus-20260420  ($0.30/$1.80 per 1M tokens, vision-capable)
#   Fast/triage     → qwen3.6-flash          ($0.19/$1.13 per 1M tokens, vision-capable)
#   Vision/reports  → qwen3.6-flash          (cheapest multimodal: text+image+video→text)
#
# All three models support image input — swap freely without code changes.
OPENROUTER_CHAT_MODEL=qwen/qwen3.5-plus-20260420
OPENROUTER_FAST_MODEL=qwen/qwen3.6-flash
OPENROUTER_VISION_MODEL=qwen/qwen3.6-flash

# Optional: human-readable app metadata sent to OpenRouter for analytics.
OPENROUTER_APP_NAME=MedAccess AI
OPENROUTER_APP_URL=http://localhost:5173

# --- Image ML sidecar (OPTIONAL) ----------------------------------------------
# Specialist medical-image models (Malaria, Pneumonia, Skin, etc.) run in a
# separate Python FastAPI service (services/image-ml/). If not set, Node gracefully
# degrades to LLM-only vision analysis (less accurate for medical images, but functional).
# Start the sidecar: `cd services/image-ml && uvicorn main:app --port 5001`
IMAGE_ML_URL=http://localhost:5001

# --- Voice (OPTIONAL): LiveKit real-time voice mode -------------------
# LiveKit Cloud account (https://livekit.io/cloud) — free tier sufficient for demo.
# Mirsaid: hand credentials to Ismail via Signal / 1Password.
# If unset, voice mode falls back to browser Web Speech API automatically.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice (OPTIONAL): direct OpenAI for Whisper STT ------------------
# OpenRouter does not proxy the audio API. If you want server-side
# transcription, set OPENAI_API_KEY here. If unset, the frontend
# falls back to the browser's Web Speech API automatically.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# --- Map provider proxy (OPTIONAL) -----------------------------------
# Server-side Google Maps Places proxy (POST /api/maps/nearby).
# API key stays on the server — never exposed to the browser.
# Get a key: https://console.cloud.google.com → APIs & Services → Maps JavaScript + Places
# Set a hard quota cap in Google Cloud to protect your budget.
# Mirsaid: hand the key to Ismail via Signal / 1Password — never email.
# Leave blank to run in stub mode (empty results, rest of app unaffected).
GOOGLE_MAPS_API_KEY=

# --- Map provider: Naver Local Search (Korea) -------------------------
# Preferred over Google when set — free, no billing card needed.
# Get keys: https://developers.naver.com/apps/#/register
#   → Create app → select API: 검색 (Search) → copy Client ID + Secret
#   → Add http://localhost:5174 and http://localhost:5173 as allowed URLs
# Provider priority: Naver → Google → stub (seed data)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Limits -----------------------------------------------------------
MAX_UPLOAD_MB=15
SESSION_TTL_MIN=60
